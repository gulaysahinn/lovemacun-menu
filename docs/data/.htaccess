# Dizin listelemeyi kapat ve seed/gecici dosyalara dogrudan erisimi engelle
Options -Indexes

<FilesMatch "(menu\.seed\.json|\.(lock|bak|tmp|log|php))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

