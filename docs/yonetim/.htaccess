# Hassas dosyalari, kutuphane betiklerini ve kilit/veri dosyalarini web erisiminden koru
Options -Indexes

<FilesMatch "^(auth\.php|paths\.php|config\.php|install_hash\.php|setup_key\.php|.*\.(json|lock|log|bak|tmp|md|txt)|\..*)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
