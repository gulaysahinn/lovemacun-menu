# Hassas dosyalari ve gizli dosyalari web erisiminden koru
Options -Indexes

<FilesMatch "^(paths\.php|config\.php|users\.json|setup_key\.php|kurulum\.lock|\..*)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
