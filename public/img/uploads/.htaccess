# Yuklenen dosyalar arasinda betik calistirilmasini engelle (Apache 2.4 ve 2.2 uyumlu)
<FilesMatch "\.(php|phtml|phar|php[0-9]|cgi|pl|exe|sh|py)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
